{
  "name": "tollbit-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n tollbooth,origin -c magenta,cyan \"pnpm dev:tollbooth\" \"pnpm dev:origin\"",
    "dev:origin": "tsx watch server/dev.ts",
    "dev:tollbooth": "tsx watch server/tollbooth/index.ts",
    "build": "vite build && node scripts/postbuild.mjs",
    "start": "NODE_ENV=production concurrently -n tollbooth,origin -c magenta,cyan \"tsx server/tollbooth/index.ts\" \"tsx server.ts\"",
    "start:origin": "NODE_ENV=production tsx server.ts",
    "agent": "tsx agent/crawl.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
