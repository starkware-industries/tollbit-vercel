# Paywall behaviour: off | mock | live
#   off  – bot gate disabled, everything served free (useful for A/B)
#   mock – bots are 302'd to the bundled local tollbooth (default, no account needed)
#   live – bots are 302'd to your real, DNS-verified TollBit subdomain
TOLLBIT_MODE=mock

# Ports
ORIGIN_PORT=5173
TOLLBOOTH_PORT=5174

# --- live mode only ---
# Your DNS-verified TollBit subdomain (setting this switches the default mode to live)
# TOLLBIT_SUBDOMAIN=tollbit.yourdomain.com
# The property domain as registered with TollBit; used as the content URL agents pay for
# PUBLISHER_DOMAIN=yourdomain.com

# --- live mode: loop protection (REQUIRED before going live) ---
# TollBit's tollbooth fetches your page back from this origin to extract content. If that
# fetch matches the bot list it gets redirected into the tollbooth again, forever.
# Ask TollBit support what user agent their content fetcher presents, and list it here.
# TOLLBIT_BYPASS_USER_AGENTS=TollBit,tollbit-fetcher
# Belt and braces: a shared secret header your edge/origin trusts to skip the gate.
# TOLLBIT_BYPASS_HEADER=x-tollbit-bypass
# TOLLBIT_BYPASS_SECRET=

# --- agent side ---
# Secret key from the TollBit developer dashboard (https://hack.tollbit.com > Access).
# Without it the playground agent uses a mock key against the local tollbooth.
# TOLLBIT_KEY=

# --- playground knobs ---
# Assumed TollBit revenue share in basis points (2000 = 20% fee, you keep 80%)
TOLLBIT_FEE_BPS=2000
# Signing secret for the mock gateway's JWTs
MOCK_TOLLBIT_SECRET=tollbit-playground-mock-secret
